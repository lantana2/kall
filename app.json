{
  "expo": {
    "name": "kall",
    "slug": "kall",
    "version": "1.1.0-beta5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.cakkacdev.kall",
      "versionCode": 14
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы оценить калории по снимку еды.",
          "cameraPermission": "Приложению нужна камера, чтобы сфотографировать еду и оценить калории."
        }
      ]
    ]
  }
}
